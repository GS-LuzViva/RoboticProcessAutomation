# Copie para .env (que não vai para o Git) ou exporte no shell. Nenhum valor real aqui.
LUZVIVA_DATA=data
LUZVIVA_DIA=dados_dia
LUZVIVA_DB=dados_dia/luzviva.db
LUZVIVA_FOTOS=fotos
# Vazio = rotas do robô e do RPA abertas (modo desenvolvimento). Em produção, defina um valor longo e aleatório.
LUZVIVA_API_TOKEN=
# Origens permitidas no CORS, separadas por vírgula. Ex.: https://site.exemplo.com
LUZVIVA_CORS=
# Serviço de IA (POST {IA_URL}/perguntar). Vazio = assistente indisponível.
IA_URL=
# Serviço de visão (POST {VISAO_URL}/detectar). Vazio = foto gravada sem visão.
VISAO_URL=
