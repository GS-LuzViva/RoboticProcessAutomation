# Copie para .env (que não vai para o Git) e preencha. Nenhum valor real aqui.
# O docker compose lê este .env; rodando sem Docker, exporte as variáveis no terminal.

# Token compartilhado entre a API e o robô (header X-API-Key). Vazio = modo desenvolvimento.
# Em produção use um valor longo e aleatório, por exemplo: python -c "import secrets;print(secrets.token_urlsafe(32))"
LUZVIVA_API_TOKEN=

# Porta do site/API na máquina (docker compose)
LUZVIVA_PORTA=8000

# Intervalo do robô em segundos (3600 = de hora em hora; use 60 para demonstração)
LUZVIVA_RPA_INTERVALO=3600

# URL da API para rodar o robô fora do Docker
LUZVIVA_API_URL=http://127.0.0.1:8000

# Opcionais do app
# Origens permitidas no CORS, separadas por vírgula
LUZVIVA_CORS=
# Serviço de IA do João Paulo (POST {IA_URL}/perguntar). Vazio = "assistente indisponível"
IA_URL=
# Serviço de visão do João Paulo (POST {VISAO_URL}/detectar). Vazio = foto gravada sem visão
VISAO_URL=
